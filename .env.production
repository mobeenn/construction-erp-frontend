# Used only by `vite build` / `vite preview` (not by `npm run dev`).
# On Vercel, set the same keys in Project → Environment Variables (Production)
# so builds use the live origins (especially VITE_API_URL after backend is live).
VITE_SITE_URL=https://construction-erp-frontend-five.vercel.app
# Set to your live backend after it is deployed, then redeploy the frontend:
VITE_API_URL=https://construction-erp-backend-virid.vercel.app
